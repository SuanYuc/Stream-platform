        1,
        64
      ]
    },
    "output": "text_embeds",
    "normalized": true
  },
  "runtime_score": "cosine = image_embeds @ text_embeds.T",
  "validation": {
    "image_max_abs_diff": 8.940696716308594e-07,
    "text_max_abs_diff": 1.3783574104309082e-07,
